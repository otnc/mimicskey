# ---- 必須: 環境ごとに異なる値 ----

# Bot アカウントがいる Misskey インスタンス (末尾スラッシュなし)
MISSKEY_INSTANCE=https://misskey.io

# Bot アカウントのアクセストークン
# Misskey の 設定 > API > アクセストークンの発行 で作成する
# 必要な権限: read:account, write:account, read:notes, write:notes,
# read:notifications, write:reactions
MISSKEY_TOKEN=YOUR_MISSKEY_TOKEN

# ---- 学習対象: 少なくとも一方は必須 ----
# 末尾に :yyyy/mm/dd を付けると、そのユーザーは JST のその日 0:00 以降の投稿だけを学習する (ユーザーごとに指定でき、省略可能)。

# Misskey の学習対象ユーザー。カンマ区切り。ローカルは username、リモートは username@host
MISSKEY_TARGET_USERS=example-user,other-user@example.instance:2024/01/01

# X (Twitter) の学習対象ユーザー。カンマ区切りのユーザー名 (先頭の @ は省略可)。
# FxTwitter の公開 API で取得するため、X のアカウントやトークンは不要 (鍵アカウントは取得できない)。リツイートは学習しない。
# TWITTER_TARGET_USERS=example_user,other_user:2025/04/01

# ---- 任意: sudachipy のパス ----
# pm2 など PATH が通らない起動環境では絶対パスで指定する。
# 省略時は "sudachipy" をそのまま呼び出す。
# SUDACHI_BIN=/home/user/bot/.venv/bin/sudachipy

# ---- 任意: ログ ----
# ログレベル: trace | debug | info | warn | error | fatal (既定: info)
# LOG_LEVEL=info
# false にすると pino-pretty を通さず生の JSON Lines で出力する (ログ収集基盤に流す場合など。既定: true)
# LOG_PRETTY=false

# ---- その他の設定は config.js (プロジェクトルート) で管理します ----
# カスタマイズしたい場合は config.custom.js を作成してください (gitignore 済み)。
